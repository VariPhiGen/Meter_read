# Copy to .env and fill in. .env is gitignored - it holds real credentials.
#
#   cp .env.example .env
#
# The camera URL. ${METER_01_RTSP_URL} in config.yaml is replaced with this at
# load time, so credentials never enter the committed config.
# Dahua/Onvif form shown; check your camera's own RTSP path.
METER_01_RTSP_URL=rtsp://user:pass@192.168.0.111:554/cam/realmonitor?channel=1&subtype=0&unicast=true&proto=Onvif

# Optional: override the broker without editing config.yaml.
# KAFKA_BOOTSTRAP_SERVERS=10.0.0.5:9092
